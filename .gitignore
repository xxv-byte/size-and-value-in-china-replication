# ---- 真实数据：只允许占位文件进入仓库 ----
data/raw/*
!data/raw/.gitkeep
!data/raw/README.md

# ---- 合成样例是仓库资产，显式放行 ----
!data/sample/**
!data/sample/raw/**
!data/sample/raw/**/*.csv

# ---- 运行产物 ----
*.parquet
*.pkl
*.log
*.zip
.ipynb_checkpoints/
__pycache__/
*.py[cod]

# ---- 虚拟环境 ----
.venv/
venv/
env/

# ---- 第三方论文 / 图书（版权原因不入库） ----
*.pdf
参考论文/

# ---- 编辑器与系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
